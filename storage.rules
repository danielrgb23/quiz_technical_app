rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Avatar do usuário: só o próprio uid escreve o próprio arquivo;
    // leitura pública (é uma foto de perfil, mostrada a outros usuários
    // eventualmente).
    match /avatars/{uid}.jpg {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
