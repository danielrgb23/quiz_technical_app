**/build/
pubspec_overrides.yaml
# Workspace único (melos/pub workspaces): só existe pubspec.lock na raiz do
# app/, e ele é versionado (não ignorado) para o CI resolver exatamente as
# mesmas versões testadas localmente — sem isso, `flutter pub get` pode
# resolver uma versão mais nova de analyzer/injectable_generator e quebrar
# o build_runner só no CI. Pacotes individuais não geram lockfile próprio
# neste modo de workspace.
apps/*/pubspec.lock
packages/*/*/pubspec.lock

