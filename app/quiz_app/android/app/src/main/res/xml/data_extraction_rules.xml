<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+ (Android 12+). Keeps the encrypted secure-storage prefs file
     out of both cloud backup and device-to-device transfer — its contents
     are only ever useful on the device that wrote them anyway (see
     SecureStorageImpl's KeychainAccessibility.first_unlock_this_device
     equivalent on iOS). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
    </device-transfer>
</data-extraction-rules>
